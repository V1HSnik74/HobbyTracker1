<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:id="@+id/projectsList"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        app:srcCompat="@drawable/projects_visible_screen"
        android:contentDescription="@string/recycler"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/projectRecyclerView"
        android:layout_width="377dp"
        android:layout_height="205dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="80dp"
        android:contentDescription="@string/recycler"
        android:nestedScrollingEnabled="true" />

    <TextView
        android:id="@+id/projectName"
        android:layout_width="238dp"
        android:layout_height="35dp"
        android:layout_marginStart="45dp"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/source_serif_pro_semibold"
        android:text="@string/proj_name"
        android:textAlignment="center"
        android:textSize="20sp" />

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="70dp"
        android:contentDescription="@string/line"
        android:src="@drawable/line_4" />

    <ImageView
        android:id="@+id/addGoal"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="end"
        app:srcCompat="@drawable/frame_288961"
        android:contentDescription="@string/add_proj_task"/>

</FrameLayout>